# =============================================================================
# AI Repository Assistant - Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local file - it contains sensitive configuration
# =============================================================================

# ===== API Configuration =====
# Backend API URL - must match your backend server
# Local development: http://localhost:8080
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# ===== GitHub OAuth Configuration =====
# Optional: GitHub Client ID for your app
# This should match the GITHUB_CLIENT_ID in backend .env
# Get from https://github.com/settings/developers
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here

# ===== Application Configuration =====
# App name for display
NEXT_PUBLIC_APP_NAME=AI Repository Assistant

# App version
NEXT_PUBLIC_APP_VERSION=0.1.0

# ===== Feature Flags =====
# Enable debug mode (shows additional logging)
NEXT_PUBLIC_DEBUG_MODE=false

# ===== Analytics (Optional) =====
# Uncomment if you want to add analytics
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
