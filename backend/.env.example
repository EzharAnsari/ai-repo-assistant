# =============================================================================
# AI Repository Assistant - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file - it contains sensitive secrets
# =============================================================================

# ===== Database Configuration =====
# PostgreSQL connection URL
DB_URL=jdbc:postgresql://localhost:5433/mydb

# Database username
DB_USERNAME=postgres

# Database password (use a strong password in production)
DB_PASSWORD=postgres

# ===== OpenAI / OpenRouter Configuration =====
# Your OpenRouter API key (get from https://openrouter.ai/keys)
# Format: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# ===== GitHub OAuth2 Configuration =====
# Register app at: https://github.com/settings/developers
# Create a new OAuth App to get these credentials

# GitHub OAuth App Client ID
GITHUB_CLIENT_ID=your_github_client_id_here

# GitHub OAuth App Client Secret
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ===== Application Configuration =====
# Frontend URL (for OAuth2 redirect and CORS)
FRONTEND_URL=http://localhost:3000

# CORS allowed origins (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== Token Encryption Configuration =====
# IMPORTANT: Generate strong random values for production!
# Use 'openssl rand -base64 32' to generate a secure password
TOKEN_ENCRYPTOR_PASSWORD=your-secure-encryption-password-change-me

# Use 'openssl rand -hex 8' to generate a secure salt
TOKEN_ENCRYPTOR_SALT=a1b2c3d4e5f67890

# ===== Server Configuration =====
# Server port (default: 8080)
SERVER_PORT=8080

# Application name
SPRING_APPLICATION_NAME=backend
